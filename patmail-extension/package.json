{
  "name": "patmail-extension",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "vue-tsc --noEmit && vite build && vite build --config vite.content.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/extension.e2e.mjs && node tests/limit-query.e2e.mjs",
    "test:e2e:limits": "node tests/limit-query.e2e.mjs",
    "pack:source": "node scripts/pack-source.mjs",
    "pack:delivery": "node scripts/pack-delivery.mjs",
    "verify:archive": "node scripts/verify-archive.mjs",
    "live:readonly": "node scripts/live-readonly.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "marked": "^18.1.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.304",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.58.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.0.0"
  }
}
