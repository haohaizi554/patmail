{
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "PatMail",
  "version": "0.1.0",
  "description": "专利发文辅助插件。当前阶段提供页面语义扫描与浮窗调试。",
  "permissions": ["tabs"],
  "host_permissions": ["http://183.36.43.66:88/*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "PatMail"
  },
  "content_scripts": [
    {
      "matches": ["http://183.36.43.66:88/*", "http://127.0.0.1/*", "http://localhost/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
