{
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "PatMail",
  "version": "0.1.0",
  "description": "专利发文自动化插件。当前阶段提供页面注入、浮窗和 DOM 扫描。",
  "permissions": ["storage", "tabs", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "PatMail"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
